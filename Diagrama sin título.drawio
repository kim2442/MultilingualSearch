        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class AIProvider {\n        &lt;&lt;abstract&gt;&gt;\n        +model: str\n        +api_key: str\n        +call_ai(prompt: str) str\n    }\n    AIProvider &lt;|-- OllamaProvider\n    AIProvider &lt;|-- OpenAIProvider\n    AIProvider &lt;|-- AnthropicProvider\n    AIProvider &lt;|-- DeepLProvider\n\n    class Translator {\n        +translate(text: str, source: str, target: str) str\n        +translate_results(results: ResultSet, target: str) None\n    }\n    class KeywordGenerator {\n        +generate_keywords(query: str, languages: list~str~) dict~str, list~str~~\n    }\n    Translator o-- \&quot;1\&quot; AIProvider : -provider\n    KeywordGenerator o-- \&quot;1\&quot; AIProvider : -provider\n\n    class Searcher {\n        +engines_by_language: dict~str, list~str~~\n        +timeout: int\n        +search(keywords: dict, languages: list~str~) ResultSet\n        -search_task(engine: str, query: str) list~Result~\n        -call_api(wait_seconds: float) dict\n    }\n    class ResultSet {\n        -items: list~Result~\n        +add_result(result: Result) None\n        +dedup() None\n        +get_results_count() int\n    }\n    class Result {\n        -title: str\n        -desc: str\n        -translated_title: str\n        -translated_desc: str\n        -url: str\n        -favicon: str\n        -search_engine: str\n        -language: str\n        -fetched_at: datetime\n        +to_text() str\n        +__eq__(other: Result) bool\n    }\n    Searcher ..&gt; ResultSet : «create»\n    ResultSet \&quot;1\&quot; *-- \&quot;0..*\&quot; Result\n\n    class Settings {\n        +provider_name: str\n        +languages: list~str~\n        +save_path: str\n    }\n    class ResultExporter {\n        +save(results: ResultSet, path: str) None\n    }\n    class SearchController {\n        +run_search(query: str) ResultSet\n        +handle_error(error: Exception) None\n    }\n    SearchController --&gt; Settings\n    SearchController --&gt; KeywordGenerator\n    SearchController --&gt; Searcher\n    SearchController --&gt; Translator\n    SearchController --&gt; ResultExporter\n    QMainWindow &lt;|-- MainWindow\n    MainWindow --&gt; SearchController\n    MainWindow --&gt; ErrorDialog&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="EqZiSRyfRm2W7BUAKTwX-1">
